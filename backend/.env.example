# Copy this file to server/.env and fill in the values. NEVER commit .env.

# Shared team database (MongoDB Atlas). Ask an admin for this connection string.
MONGODB_DB=

# universities_init holds the config for each supported university (name,
# source pages to scrape). universities_info holds the LLM-generated
# tuition/scholarship data once a university has been opened.
MONGODB_INIT_COLLECTION=
MONGODB_INFO_COLLECTION=

MONGODB_ATLAS_URI=

# Optional: protects /admin.html when the server is reachable from other machines.
ADMIN_TOKEN=

# Optional
PORT=3000
PYTHON_BIN=
AUTO_REFRESH_HOURS=0
REFRESH_CONCURRENCY=2

# --- Redis cache for the Universities pages (optional) ---
# Makes the universities list and each university's page load from Redis
# instead of MongoDB. Leave empty to switch the cache off. Locally, e.g.
#   docker run -d --name bilimlaunch-redis -p 6379:6379 redis:7
# then REDIS_URL=redis://localhost:6379  (hosted Redis: rediss://user:password@host:port)
REDIS_URL=
# Safety-net expiry; every change through the app or scripts clears the cache anyway.
CACHE_TTL_SECONDS=3600

# --- User accounts: PostgreSQL (Neon), JWT, Resend e-mail, Google sign-in ---
# See README, "User accounts". Create the tables once with:  node migrate-pg.js

# Neon connection string, e.g. postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Two DIFFERENT random strings, 32+ characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Public address of the site, no trailing slash. Used for the Google redirect
# address and to mark cookies "Secure" when it starts with https://
APP_BASE_URL=http://localhost:3000

# Resend (https://resend.com). The sending domain must be verified there.
# Without a key (and outside production) codes are printed in the server console.
RESEND_API_KEY=
EMAIL_FROM=BilimLaunch <no-reply@bilimlaunch.com>

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional
# NODE_ENV=production          (on the live server)
# TRUST_PROXY=1                (when the server sits behind a proxy / load balancer)
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=30
# BCRYPT_ROUNDS=12
# PG_POOL_MAX=10

# --- University photos: Cloudflare R2 object storage ---
# Cloudflare dashboard -> R2 Object Storage. The account ID is on the R2 overview
# page; the keys come from "Manage API tokens" -> Create API token with
# "Object Read & Write" permission on your bucket only. Without these settings
# the site works normally, just without photos.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: the bucket's public address (custom domain, or the r2.dev URL from
# bucket Settings -> Public access), no trailing slash, e.g. https://media.example.com
# Leave empty to serve photos through this server at /media/... (bucket stays private).
R2_PUBLIC_URL=
# Optional: only for a bucket created with a jurisdiction (e.g. EU):
# R2_ENDPOINT=https://<account-id>.eu.r2.cloudflarestorage.com
