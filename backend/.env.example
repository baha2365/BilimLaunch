# Copy this file to .env (in this same server/ folder) and adjust if your
# MongoDB isn't on the default local address -- e.g. paste in an Atlas
# connection string for MONGODB_URI.

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=universities

# universities_init holds the config for each supported university (name,
# source pages to scrape). universities_info holds the LLM-generated
# tuition/scholarship data once a university has been opened.
MONGODB_INIT_COLLECTION=universities_init
MONGODB_INFO_COLLECTION=universities_info

# Uncomment to run on a different port:
# PORT=3000

# Uncomment on Windows if "node" can't start Python as "python3":
# PYTHON_BIN=python
