# Copy this file to server/.env and fill in the values. NEVER commit .env.

# Shared team database (MongoDB Atlas). Ask an admin for this connection string.
MONGODB_DB=

# universities_init holds the config for each supported university (name,
# source pages to scrape). universities_info holds the LLM-generated
# tuition/scholarship data once a university has been opened.
MONGODB_INIT_COLLECTION=
MONGODB_INFO_COLLECTION=

MONGODB_ATLAS_URI=

# Optional: protects /admin.html when the server is reachable from other machines.
ADMIN_TOKEN=

# Optional
PORT=3000
PYTHON_BIN=
AUTO_REFRESH_HOURS=0
REFRESH_CONCURRENCY=2

# --- User accounts: PostgreSQL (Neon), JWT, Resend e-mail, Google sign-in ---
# See README, "User accounts". Create the tables once with:  node migrate-pg.js

# Neon connection string, e.g. postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Two DIFFERENT random strings, 32+ characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Public address of the site, no trailing slash. Used for the Google redirect
# address and to mark cookies "Secure" when it starts with https://
APP_BASE_URL=http://localhost:3000

# Resend (https://resend.com). The sending domain must be verified there.
# Without a key (and outside production) codes are printed in the server console.
RESEND_API_KEY=
EMAIL_FROM=BilimLaunch <no-reply@bilimlaunch.com>

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional
# NODE_ENV=production          (on the live server)
# TRUST_PROXY=1                (when the server sits behind a proxy / load balancer)
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=30
# BCRYPT_ROUNDS=12
# PG_POOL_MAX=10
